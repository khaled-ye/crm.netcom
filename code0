function getTodayFR() {
  const d = new Date();
  const day = String(d.getDate()).padStart(2, '0');
  const month = String(d.getMonth() + 1).padStart(2, '0');
  const year = d.getFullYear();
  return `${day}/${month}`;
}
const today = getTodayFR();

function saveTableToLocalStorage() {
  const table = document.getElementById("ctl00_ContentPlaceHolder2_GvTickets");
  let data = [];
  
  for (let i = 1; i < table.rows.length; i++) {
    let row = table.rows[i];
    data.push({
      col1: row.cells[0].innerText,
    });
  }  
  localStorage.setItem("tableData", JSON.stringify(data));
}

function chargerTableau() {
    let donneesStockees = localStorage.getItem("tableData");
    if (donneesStockees) {
        let data = JSON.parse(donneesStockees);
        let result = data.map(elmt => elmt.col1);
	return result;        
    }
}
