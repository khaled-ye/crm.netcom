    #raw-blink {
        /* 0.5s duration, instant state changes, loops infinitely */
        animation: rawBlinkEffect 0.5s step-start infinite;
    }

    @keyframes rawBlinkEffect {
        0% { opacity: 1; }
        50% { opacity: 0; }
        100% { opacity: 1; }
    }
